<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="clr-namespace:FortnitePorting.ViewModels.Settings"
             xmlns:controls="clr-namespace:FortnitePorting.Controls.Settings"
             x:Class="FortnitePorting.Views.MaterialPorter.OfficialRigSettings"
             xmlns:ext="clr-namespace:FortnitePorting.Extensions;assembly=FortnitePorting"
             x:DataType="settings:BlenderSettingsViewModel">
    <StackPanel Spacing="{ext:Space 0, 0, 0, 1}">
        <controls:SettingsItem Title="Extra Hand Controls" IsVisible="{Binding IsOfficialRig}"
                               Description="Adds hand controls on top of Epic's finger controls: curl and spread every finger, cup the palm, curl one finger. Not part of Epic's rig.">
            <controls:SettingsItem.Footer>
                <ToggleSwitch IsChecked="{Binding OfficialRigHandControls}"/>
            </controls:SettingsItem.Footer>
        </controls:SettingsItem>
        <controls:SettingsItem Title="Face Board"
                               Description="Puts a face board (MetaHuman controls) on regular characters. Off keeps their face bones as they are, to pose them directly. LEGO figures and creatures keep theirs.">
            <controls:SettingsItem.Footer>
                <ToggleSwitch IsChecked="{Binding FaceBoard}"/>
            </controls:SettingsItem.Footer>
        </controls:SettingsItem>
    </StackPanel>
</UserControl>
