<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:windowModels="clr-namespace:FortnitePorting.WindowModels"
             xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:mp="clr-namespace:FortnitePorting.MaterialPorter"
             x:Class="FortnitePorting.Views.MaterialPorter.StatusBar">
    <!-- an export's log in a drawer (the app's steps, what Blender reports while it imports), the status line under it -->
    <Grid RowDefinitions="Auto, Auto">
        <Border Grid.Row="0" Height="200" DataContext="{x:Static mp:StatusLog.Instance}" x:DataType="mp:StatusLog"
                IsVisible="{Binding IsOpen}" Background="{DynamicResource ContentBorderBackgroundBrush}"
                BorderBrush="{DynamicResource ContentBorderBorderBrush}" BorderThickness="0,1,0,0">
            <ListBox ItemsSource="{Binding Lines}" Background="Transparent" Padding="8,2">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="2,0" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <SelectableTextBlock Text="{Binding}" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="11.5"
                                             Classes="TextFillColorSecondaryBrush" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
        <Border Grid.Row="1" DataContext="{x:Static mp:StatusLog.Instance}" x:DataType="mp:StatusLog"
                IsVisible="{Binding $parent[Window].((windowModels:AppWindowModel)DataContext).Settings.Installation.FinishedSetup}"
                Background="{DynamicResource WindowBackgroundBrush}"
                BorderBrush="{DynamicResource ContentBorderBorderBrush}" BorderThickness="0,1,0,0" Padding="10,0">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" Height="24">
                <ProgressBar Grid.Column="0" IsIndeterminate="True" Width="56" MinWidth="56" MinHeight="3" Height="3"
                             VerticalAlignment="Center" Margin="0,0,8,0" IsVisible="{Binding IsBusy}" />
                <TextBlock Grid.Column="1" Text="{Binding BusyWhat, StringFormat='{}{0}  ·  '}" FontSize="11.5"
                           Classes="TextFillColorPrimaryBrush" VerticalAlignment="Center" IsVisible="{Binding IsBusy}" />
                <TextBlock Grid.Column="2" Text="{Binding LastLine}" FontSize="11.5" Classes="TextFillColorSecondaryBrush"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding LastLine}" />
                <Button Grid.Column="3" Content="Clear" FontSize="11.5" Padding="8,1" Margin="0,0,6,0" VerticalAlignment="Center"
                        Command="{Binding ClearCommand}" IsVisible="{Binding IsOpen}" ToolTip.Tip="Clear the log" />
                <ToggleButton Grid.Column="4" IsChecked="{Binding IsOpen}" FontSize="11.5" Padding="8,1" VerticalAlignment="Center"
                              ToolTip.Tip="What exports and imports did">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <material:MaterialIcon Kind="TextBoxOutline" Width="13" Height="13" />
                        <TextBlock Text="Log" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
            </Grid>
        </Border>
    </Grid>
</UserControl>
