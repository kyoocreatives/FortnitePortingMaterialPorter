<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ext="clr-namespace:FortnitePorting.Extensions;assembly=FortnitePorting"
             xmlns:settings="clr-namespace:FortnitePorting.ViewModels.Settings"
             xmlns:controls="clr-namespace:FortnitePorting.Controls.Settings"
             x:Class="FortnitePorting.Views.MaterialPorter.ExactMaterialSettings"
             x:DataType="settings:BlenderSettingsViewModel">
    <StackPanel Spacing="{ext:Space 0, 0, 0, 1}">
        <controls:SettingsItem Title="Prefer FP Shaders for Characters"
                               Description="Outfits, back blings, pickaxes, gliders, pets, kicks and sidekicks use FP's prebuilt shaders where FP has one for a material; the others keep the exact material rebuilt from its Unreal graph."
                               IsEnabled="{Binding ExportMaterials}">
            <controls:SettingsItem.Footer>
                <ToggleSwitch IsChecked="{Binding PreferFPShaders}"/>
            </controls:SettingsItem.Footer>
        </controls:SettingsItem>
        <controls:SettingsItem Title="Rim Light"
                               Description="Keeps the rim light Fortnite's character materials add at the edges of a silhouette (their baseBrightness). Off: baseBrightness is 0 on exact materials."
                               IsEnabled="{Binding ExportMaterials}">
            <controls:SettingsItem.Footer>
                <ToggleSwitch IsChecked="{Binding RimLight}"/>
            </controls:SettingsItem.Footer>
        </controls:SettingsItem>
        <controls:SettingsItem Title="Skin Subsurface"
                               Description="How much light scatters under skin, where the game's material scatters (x its amount)."
                               IsEnabled="{Binding ExportMaterials}">
            <controls:SettingsItem.Footer>
                <StackPanel Orientation="Horizontal">
                    <Slider Value="{Binding SubsurfaceIntensity}" MinWidth="200"
                            Minimum="0" Maximum="1"
                            TickFrequency="0.05" TickPlacement="BottomRight"
                            IsSnapToTickEnabled="True"/>
                    <TextBlock Text="{Binding SubsurfaceIntensity, StringFormat=N2}"
                               VerticalAlignment="Center" Margin="{ext:Space 1, 0, 0, 0}"/>
                </StackPanel>
            </controls:SettingsItem.Footer>
        </controls:SettingsItem>
        <controls:SettingsItem Title="Base Subsurface"
                               Description="Light scattering over the whole of a cosmetic, clothes included, for a softer look. 0: only where the game scatters."
                               IsEnabled="{Binding ExportMaterials}">
            <controls:SettingsItem.Footer>
                <StackPanel Orientation="Horizontal">
                    <Slider Value="{Binding BaseSubsurface}" MinWidth="200"
                            Minimum="0" Maximum="1"
                            TickFrequency="0.05" TickPlacement="BottomRight"
                            IsSnapToTickEnabled="True"/>
                    <TextBlock Text="{Binding BaseSubsurface, StringFormat=N2}"
                               VerticalAlignment="Center" Margin="{ext:Space 1, 0, 0, 0}"/>
                </StackPanel>
            </controls:SettingsItem.Footer>
        </controls:SettingsItem>
        <controls:SettingsItem Title="Scatter Distance"
                               Description="How far light scatters, x the game's distance (1: the game's)."
                               IsEnabled="{Binding ExportMaterials}">
            <controls:SettingsItem.Footer>
                <StackPanel Orientation="Horizontal">
                    <Slider Value="{Binding SubsurfaceScale}" MinWidth="200"
                            Minimum="0" Maximum="10"
                            TickFrequency="0.25" TickPlacement="BottomRight"
                            IsSnapToTickEnabled="True"/>
                    <TextBlock Text="{Binding SubsurfaceScale, StringFormat=N2}"
                               VerticalAlignment="Center" Margin="{ext:Space 1, 0, 0, 0}"/>
                </StackPanel>
            </controls:SettingsItem.Footer>
        </controls:SettingsItem>
        <controls:SettingsItem Title="Profile Colour"
                               Description="How much of the skin profile's colour the scattering keeps. 1: the game's; lower softens coloured profiles that darken and saturate skin."
                               IsEnabled="{Binding ExportMaterials}">
            <controls:SettingsItem.Footer>
                <StackPanel Orientation="Horizontal">
                    <Slider Value="{Binding ProfileColour}" MinWidth="200"
                            Minimum="0" Maximum="1"
                            TickFrequency="0.05" TickPlacement="BottomRight"
                            IsSnapToTickEnabled="True"/>
                    <TextBlock Text="{Binding ProfileColour, StringFormat=N2}"
                               VerticalAlignment="Center" Margin="{ext:Space 1, 0, 0, 0}"/>
                </StackPanel>
            </controls:SettingsItem.Footer>
        </controls:SettingsItem>
        <controls:SettingsItem Title="Fur Subsurface Intensity"
                               Description="How much light scatters under shell fur (all of it) and the skin under it (where the game's scatters any). Higher: softer fur that blends into the body."
                               IsEnabled="{Binding ExportMaterials}">
            <controls:SettingsItem.Footer>
                <StackPanel Orientation="Horizontal">
                    <Slider Value="{Binding FurSubsurfaceIntensity}" MinWidth="200"
                            Minimum="0" Maximum="1"
                            TickFrequency="0.05" TickPlacement="BottomRight"
                            IsSnapToTickEnabled="True"/>
                    <TextBlock Text="{Binding FurSubsurfaceIntensity, StringFormat=N2}"
                               VerticalAlignment="Center" Margin="{ext:Space 1, 0, 0, 0}"/>
                </StackPanel>
            </controls:SettingsItem.Footer>
        </controls:SettingsItem>
        <controls:SettingsItem Title="Fur Subsurface Scale"
                               Description="How far light scatters under shell fur and the skin under it, times the game's distance (1: the game's)."
                               IsEnabled="{Binding ExportMaterials}">
            <controls:SettingsItem.Footer>
                <StackPanel Orientation="Horizontal">
                    <Slider Value="{Binding FurSubsurfaceScale}" MinWidth="200"
                            Minimum="0" Maximum="20"
                            TickFrequency="0.5" TickPlacement="BottomRight"
                            IsSnapToTickEnabled="True"/>
                    <TextBlock Text="{Binding FurSubsurfaceScale, StringFormat=N2}"
                               VerticalAlignment="Center" Margin="{ext:Space 1, 0, 0, 0}"/>
                </StackPanel>
            </controls:SettingsItem.Footer>
        </controls:SettingsItem>
    </StackPanel>
</UserControl>
