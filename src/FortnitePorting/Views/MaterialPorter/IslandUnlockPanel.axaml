<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:FortnitePorting.ViewModels"
             xmlns:ext="clr-namespace:FortnitePorting.Extensions;assembly=FortnitePorting"
             xmlns:controls="clr-namespace:FortnitePorting.Controls"
             x:Class="FortnitePorting.Views.MaterialPorter.IslandUnlockPanel"
             x:DataType="viewModels:MapViewModel">
    <StackPanel Spacing="{ext:Space 1}" IsVisible="{Binding CanUnlockIslands}">
        <TextBox Text="{Binding IslandCode}" Watermark="Island code (1234-5678-9012)" IsEnabled="{Binding !IsUnlockingIsland}"/>
        <Button HorizontalAlignment="Stretch" Content="{controls:IconText 'Unlock Island', LockOpen}"
                IsEnabled="{Binding !IsUnlockingIsland}"
                Command="{Binding UnlockIslandCommand}"/>
        <TextBlock Text="{Binding IslandStatus}" TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                   IsVisible="{Binding IslandStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
    </StackPanel>
</UserControl>
